# ENTSO-E Transparency Platform API key.
# https://transparency.entsoe.eu -> create an account -> "My Account Settings"
# -> request a Web API key.
ENTSOE_API_KEY=put-your-own-key-here

# TimescaleDB connection (brought up via docker-compose).
# Format: postgresql+psycopg://user:password@host:port/database
DATABASE_URL=postgresql+psycopg://energy:energy@localhost:5432/energy_market

# Force the synthetic data fallback even if a key is present (offline/testing).
# Leave unset (or 0) to use the real ENTSO-E path when a key is available.
# USE_SYNTHETIC=1
